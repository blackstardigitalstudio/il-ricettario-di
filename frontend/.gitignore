# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Native projects are generated by EAS via `expo prebuild` (CNG) from app.json
# and its config plugins. Do NOT commit android/ or ios/ — committing a stale
# native folder makes EAS skip prebuild and use incompatible native code
# ("No matching variant ... No variants exist" against newer AGP). Same approach
# as the other two apps (accadde-oggi, lo-sapevi-che), whose builds succeed.
/android
/ios

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

app-example
